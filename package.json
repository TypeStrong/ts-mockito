{
  "name": "@typestrong/ts-mockito",
  "version": "2.7.12",
  "description": "Mocking library for TypeScript",
  "type": "module",
  "main": "./dist/ts-mockito.cjs",
  "module": "./dist/ts-mockito.mjs",
  "types": "./dist/ts-mockito.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/ts-mockito.d.mts",
        "default": "./dist/ts-mockito.mjs"
      },
      "require": {
        "types": "./dist/ts-mockito.d.cts",
        "default": "./dist/ts-mockito.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --import tsx --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage.lcov --test-reporter=spec --test-reporter-destination=stdout \"test/**/*.test.ts\"",
    "test:ci": "node --import tsx --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage.lcov --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results.xml \"test/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"test/**/*.test.ts\"",
    "test:compile-check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "docs:start": "npm --prefix website start",
    "docs:build": "npm --prefix website run build"
  },
  "author": "kuster.maciej@gmail.com",
  "contributors": [
    "Andrew Bradley <cspotcode@gmail.com>",
    "Liron Hazan",
    "Roy Peled"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TypeStrong/ts-mockito"
  },
  "keywords": [
    "mock",
    "typescript",
    "tests",
    "fake",
    "stub",
    "spy",
    "javascript"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.14.182",
    "@types/node": "^26.2.0",
    "@types/safe-json-stringify": "^1.1.2",
    "eslint": "^10.8.1",
    "expect": "^30.4.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "lodash": "^4.17.5",
    "safe-json-stringify": "^1.2.0"
  }
}
