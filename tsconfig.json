{
  "compilerOptions": {
    "outDir": "./lib",
    "experimentalDecorators": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2020",
    "esModuleInterop": true,
    "removeComments": true,
    "sourceMap": true,
    "declaration": true,
    "strictNullChecks": true,
    "lib": [
      "es2020"
    ],
    "types": [
      "node",
      "lodash"
    ]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
